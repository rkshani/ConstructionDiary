<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ConstructionDiary" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Splash screen (androidx core-splashscreen), then the normal theme. -->
    <style name="Theme.ConstructionDiary.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_orange</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ConstructionDiary</item>
    </style>
</resources>
